# Reverse proxy TLS untuk DMB Mobile Banking (contoh — sesuaikan sebelum dipakai).
# Salin ke /etc/nginx/conf.d/mbanking.conf, ganti <DOMAIN-API> dan path sertifikat.
# Backend harus listen di 127.0.0.1:8080 dan TRUSTED_PROXIES=127.0.0.1.

limit_req_zone $binary_remote_addr zone=mbanking_api:10m rate=20r/s;

server {
    listen 80;
    server_name <DOMAIN-API>;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <DOMAIN-API>;

    ssl_certificate     /etc/ssl/mbanking/fullchain.pem;   # sertifikat resmi bank (BLOCKED sampai diterbitkan)
    ssl_certificate_key /etc/ssl/mbanking/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Header keamanan utama diset aplikasi; HSTS juga diset di sini untuk semua respons.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 5m;          # upload konsol admin dibatasi 4 MB di aplikasi
    proxy_read_timeout 50s;           # > WriteTimeout API server (45 s) + margin
    proxy_send_timeout 30s;

    # Konsol admin: batasi ke jaringan kantor/VPN bank (isi daftar IP resmi).
    location /admin {
        # allow <CIDR-KANTOR>;
        # deny all;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/mbanking-proxy.conf;
    }
    location /api/v1/admin {
        # allow <CIDR-KANTOR>;
        # deny all;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/mbanking-proxy.conf;
    }

    location /api/ {
        limit_req zone=mbanking_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/snippets/mbanking-proxy.conf;
    }

    # Probe hanya dari jaringan monitoring internal.
    location = /health { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/mbanking-proxy.conf; }
    location = /ready  { allow 127.0.0.1; deny all; proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/mbanking-proxy.conf; }

    location / { return 404; }
}

# --- /etc/nginx/snippets/mbanking-proxy.conf ---
# proxy_set_header Host              $host;
# proxy_set_header X-Real-IP         $remote_addr;
# proxy_set_header X-Forwarded-For   $remote_addr;   # timpa (jangan append) agar tidak dapat dipalsukan klien
# proxy_set_header X-Forwarded-Proto $scheme;
# proxy_http_version 1.1;
