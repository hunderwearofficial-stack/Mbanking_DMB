  "item": [
    {
      "name": "1. Health Check (Ping)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{cbs_base_url}}/ping",
          "host": [
            "{{cbs_base_url}}"
          ],
          "path": [
            "ping"
          ]
        }
      }
    },
    {
      "name": "2. OAuth - Get Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    if (json.data && json.data.accessToken) {",
              "        pm.collectionVariables.set('cbs_token', json.data.accessToken);",
              "        pm.collectionVariables.set('cbs_refresh_token', json.data.refreshToken);",
              "        console.log('Token updated successfully!');",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{cbs_client_id}}\",\n  \"clientSecret\": \"{{cbs_client_secret}}\"\n}"
        },
        "url": {
          "raw": "{{cbs_base_url}}/api/oauth/access-token",
          "host": [
            "{{cbs_base_url}}"
          ],
          "path": [
            "api",
            "oauth",
            "access-token"
          ]
        }
      }
    },
    {
      "name": "3. OAuth - Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    if (json.data && json.data.accessToken) {",
              "        pm.collectionVariables.set('cbs_token', json.data.accessToken);",
              "        if (json.data.refreshToken) pm.collectionVariables.set('cbs_refresh_token', json.data.refreshToken);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
