    {
      "name": "4. Katalog Produk (/api/products)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1. Minify JSON body",
              "let bodyStr = \"{}\";",
              "try {",
              "    if (pm.request.body && pm.request.body.raw) {",
              "        bodyStr = JSON.stringify(JSON.parse(pm.request.body.raw));",
              "        pm.request.body.raw = bodyStr;",
              "    }",
              "} catch (e) {}",
              "",
              "// 2. Compute lowercase hex SHA-256 of minified body",
              "const bodyHash = CryptoJS.SHA256(bodyStr).toString(CryptoJS.enc.Hex).toLowerCase();",
              "",
              "// 3. Generate ISO-8601 timestamp with offset (+07:00)",
              "const now = new Date();",
              "const pad = (n) => String(n).padStart(2, \"0\");",
              "const timestamp = `${now.getFullYear()}-${pad(now.getMonth()+1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}+07:00`;",
              "pm.variables.set(\"x_timestamp\", timestamp);",
              "",
              "// 4. Resolve Path correctly (getPath returns string)",
              "let path = \"\";",
              "try {",
              "    path = pm.request.url.getPath();",
              "} catch (e) {",
              "    if (pm.request.url.path && Array.isArray(pm.request.url.path)) {",
              "        path = \"/\" + pm.request.url.path.join(\"/\");",
              "    }",
              "}",
              "if (!path.startsWith(\"/\")) path = \"/\" + path;",
              "",
              "// 5. Get Token and Secret",
              "const method = pm.request.method.toUpperCase();",
              "const token = pm.collectionVariables.get(\"cbs_token\") || pm.environment.get(\"cbs_token\") || pm.variables.get(\"cbs_token\") || \"\";",
              "const secret = pm.collectionVariables.get(\"cbs_client_secret\") || pm.environment.get(\"cbs_client_secret\") || \"9fa4b3934fa44387f811563879594c2abb75cce6ceaa7ec4\";",
              "const clientId = pm.collectionVariables.get(\"cbs_client_id\") || pm.environment.get(\"cbs_client_id\") || \"DMBMOBILE01\";",
              "pm.variables.set(\"cbs_client_id\", clientId);",
              "",
              "// 6. Build StringToSign: METHOD:PATH:ACCESS_TOKEN:HEX_SHA256:X-TIMESTAMP",
              "const stringToSign = `${method}:${path}:${token}:${bodyHash}:${timestamp}`;",
              "",
              "// 7. Compute Base64 HMAC-SHA512",
              "const signature = CryptoJS.HmacSHA512(stringToSign, secret).toString(CryptoJS.enc.Base64);",
              "pm.variables.set(\"x_signature\", signature);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{cbs_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "X-Client-ID",
            "value": "{{cbs_client_id}}"
          },
          {
            "key": "X-TIMESTAMP",
            "value": "{{x_timestamp}}"
          },
          {
            "key": "X-Signature",
            "value": "{{x_signature}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{cbs_base_url}}/api/products",
          "host": [
            "{{cbs_base_url}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
