# =========================================================
# MBANKING BPR ENVIRONMENT CONFIGURATION
# =========================================================
#
# Cara pakai di komputer Windows developer (LOCAL):
#   Copy-Item .env.example .env      lalu isi nilai yang kosong.
#   Periksa:  go run ./cmd/api -check-config
#
# Aturan:
#   - .env HANYA untuk LOCAL dan tidak boleh masuk Git.
#   - DEVELOPMENT / STAGING / PRODUCTION TIDAK memakai file: semua nilai diberikan
#     melalui environment server atau Secret Manager. Bila backend menemukan file .env
#     saat APP_ENV bukan local, backend MENOLAK start.
#   - Variabel wajib kosong / format salah -> backend menolak start dan menyebut variabelnya.
#   - Secret tidak pernah dicetak ke log. Jangan memakai secret yang sama antar-environment.
#   - Komentar SELALU di baris sendiri (docker compose membaca komentar di akhir baris
#     sebagai bagian dari nilai).
#   - Membuat secret acak (PowerShell):
#       -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#     menghasilkan 64 karakter hex.
#
# Pilihan environment:
#   local        komputer developer (membaca file .env ini)
#   development  server pengembangan (environment server)
#   staging      pra-produksi, aturan setara production (environment server)
#   production   layanan nasabah (environment server / Secret Manager)
#
# Fungsi: menentukan environment & aturan keamanan yang berlaku.
# Wajib. Di file .env nilainya HARUS local.
# Salah isi: backend menolak start.
APP_ENV=local


# =========================================================
# A. LOCAL CONFIGURATION
# =========================================================
# Konfigurasi untuk komputer Windows developer + HP Android fisik di Wi-Fi yang sama.
# Database local: docker-compose.local.yml (PostgreSQL di 127.0.0.1:5433).

# ---------- A1. Server HTTP ----------

# Alamat listen backend. Opsional.
# Local: KOSONGKAN agar HP Android di jaringan Wi-Fi yang sama dapat terhubung
# (akses dibatasi firewall: scripts/local/secure-firewall.ps1).
# Isi 127.0.0.1 bila hanya diuji dari komputer ini.
APP_HOST=

# Port backend. Opsional, angka 1..65535, default 8080.
APP_PORT=8080

# Versi aplikasi yang tercatat di log. Opsional di local, WAJIB di staging/production.
APP_VERSION=local-dev

# ---------- A2. Database PostgreSQL (role aplikasi) ----------

# Host PostgreSQL. Wajib. Local: 127.0.0.1 (database TIDAK dibuka ke HP / jaringan).
DB_HOST=127.0.0.1

# Port PostgreSQL. Opsional (default 5432). Local docker: 5433.
DB_PORT=5433

# Nama database. Wajib. Local: mbanking_local (terpisah dari database lain).
DB_NAME=mbanking_local

# Role database APLIKASI. Wajib. Selalu mbanking_app (bukan pemilik tabel, tidak dapat
# mengubah audit trail). Role dibuat otomatis oleh container local.
DB_USER=mbanking_app

# Password role aplikasi. Wajib di staging/production; local: isi string acak.
# Dipakai juga oleh docker-compose.local.yml saat membuat role.
DB_PASS=

# Mode TLS ke database. Wajib: disable | require | verify-ca | verify-full.
# disable HANYA untuk database di komputer sendiri. Server: verify-full.
DB_SSL=disable

# Batas koneksi. Opsional: 1..500 (default 25) dan 0..500 (default 10, <= MAX_OPEN).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# ---------- A3. Database: role pemilik skema & pembaca audit ----------

# Role PEMILIK SKEMA, hanya dipakai `go run ./cmd/migrate up` (bukan oleh backend).
# Wajib saat migrasi. Local: dibuat container sebagai superuser database local.
MIGRATION_DB_USER=mbanking_local_owner

# Password role pemilik skema. Wajib saat migrasi; local: string acak.
MIGRATION_DB_PASS=

# Password role baca-saja audit (mbanking_audit_reader). Dipakai docker-compose saat
# membuat role. Local: string acak.
AUDIT_DB_PASS=

# ---------- A4. Redis ----------

# Host Redis untuk state OTP & rate limit. Local/development: KOSONGKAN = memori proses
# (satu instance, hilang saat restart). WAJIB di staging/production.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# ---------- A5. Keamanan ----------

# Kunci tanda tangan token nasabah. Wajib, minimal 32 karakter acak.
# Bocor = token login dapat dipalsukan. Rotasi = semua nasabah login ulang.
JWT_SECRET=

# Umur access token (menit, 1..60, default 15) & refresh token (hari, 1..30, default 7).
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Kunci token petugas backoffice. Wajib, minimal 32 karakter, BERBEDA dari JWT_SECRET.
ADMIN_JWT_SECRET=

# Umur token petugas (menit, 1..480, default 60).
ADMIN_JWT_EXPIRY_MINUTES=60

# Membuat/mereset akun SUPER_ADMIN sekali. Opsional; isi keduanya (password >= 12
# karakter, bukan password yang pernah dipublikasikan) lalu KOSONGKAN setelah login.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Kunci AES-256 data pribadi nasabah. Wajib: 64 karakter hex (32 byte) atau base64 32 byte.
# Passphrase ditolak. Hilang = data terenkripsi tidak dapat dibaca.
DB_ENCRYPTION_KEY=

# Kunci lama (hanya dekripsi) selama rotasi kunci (go run ./cmd/rekey). Opsional.
DB_ENCRYPTION_KEY_PREVIOUS=

# IP/CIDR reverse proxy yang boleh mengisi X-Forwarded-For. Opsional.
# Local: kosong (HP terhubung langsung). Server: alamat reverse proxy.
TRUSTED_PROXIES=

# Origin web yang diizinkan (CORS). Opsional; kosong = tanpa cross-origin.
CORS_ALLOWED_ORIGINS=

# ---------- A5b. Proteksi Kunci Perangkat & Attestation ----------

# Mode ikatan kunci perangkat: off | dual | enforced (WAJIB diisi eksplisit di staging/production).
DEVICE_BINDING_MODE=dual

# Mode verifikasi hardware attestation: off | observe | enforce (WAJIB diisi eksplisit di staging/production).
DEVICE_ATTESTATION_MODE=observe

# Wajibkan Verified Boot pada Android Key Attestation (WAJIB diisi eksplisit di staging/production).
DEVICE_ATTESTATION_ANDROID_REQUIRE_VERIFIED_BOOT=true

# File PEM root CA & daftar pencabutan Google Key Attestation (wajib bila attestation bukan off di staging/production).
DEVICE_ATTESTATION_ANDROID_ROOTS_FILE=
DEVICE_ATTESTATION_ANDROID_REVOCATION_FILE=
DEVICE_ATTESTATION_ANDROID_PACKAGE=
DEVICE_ATTESTATION_ANDROID_CERT_SHA256=

# File PEM root CA & identitas Apple App Attest (wajib bila attestation bukan off di staging/production).
DEVICE_ATTESTATION_APPLE_ROOT_FILE=
DEVICE_ATTESTATION_APPLE_APP_ID=
DEVICE_ATTESTATION_APPLE_ENVIRONMENT=production

# Alasan & batas waktu (RFC3339, maks 72 jam) jika proteksi perangkat dimatikan sementara di staging/production.
DEVICE_BINDING_OFF_REASON=
DEVICE_BINDING_OFF_UNTIL=

# ---------- A5c. Kebijakan OTP, MFA Backoffice & Batas Request ----------

# Umur kode OTP (menit, 1..10, default 3) & batas percobaan OTP (3..10, default 5).
OTP_TTL_MINUTES=3
OTP_MAX_ATTEMPTS=5

# Daftar host gateway OTP resmi (dipisahkan koma, tanpa skema/path). WAJIB di production.
OTP_GATEWAY_ALLOWED_HOSTS=

# Wajibkan MFA TOTP untuk login petugas backoffice (default false di local, wajib true di staging/production).
ADMIN_MFA_REQUIRED=false

# Batas gagal login petugas sebelum akun dikunci sementara (3..10, default 5) & durasi kunci (menit, 5..1440, default 15).
ADMIN_MAX_FAILED_LOGIN=5
ADMIN_LOCKOUT_MINUTES=15

# Pengali batas rate limit (1..100; default 50 di local/dev, WAJIB 1 di staging/production).
RATE_LIMIT_MULTIPLIER=50

# Ukuran maksimum body JSON non-multipart dalam byte (default 1048576 = 1 MB).
MAX_JSON_BODY_BYTES=1048576

# ---------- A6. Core Banking System (CBS) ----------

# true = ledger PostgreSQL local pengganti CBS untuk pengujian (TANPA data dummy:
# nasabah uji dibuat dengan scripts/local/create-test-customer.ps1).
# Hanya local/development; DITOLAK di staging & production.
ENABLE_MOCK_CBS=true

# URL CBS OpenAPI (https://). Wajib bila ENABLE_MOCK_CBS=false.
# Local boleh memakai CBS DEVELOPMENT resmi dari vendor — JANGAN kredensial production.
CBS_BASE_URL=

# Client ID & secret OAuth dari vendor CBS (secret juga kunci HMAC signature).
# Wajib bila ENABLE_MOCK_CBS=false.
CBS_CLIENT_ID=
CBS_CLIENT_SECRET=

# Timeout per panggilan CBS (detik, 1..60, default 15).
CBS_TIMEOUT_SEC=15

# CATATAN: STANDALONE_CORE DITOLAK di semua environment (docs/SYSTEM_ARCHITECTURE.md).


# =========================================================
# B. DEVELOPMENT CONFIGURATION
# =========================================================
# Konfigurasi untuk server pengembangan. Nilai diberikan melalui environment server
# (bukan file). Variabel sama dengan bagian A, dengan perbedaan:
#   APP_ENV=development
#   DB_NAME=mbanking_dev, DB_SSL=require (atau verify-full), credential KHUSUS development
#   REDIS_HOST/REDIS_PASS disarankan diisi
#   CBS: CBS development resmi (ENABLE_MOCK_CBS=false) atau ledger local (true)
#   Endpoint API terpisah, mis. https://<domain-api-development>


# =========================================================
# C. STAGING CONFIGURATION
# =========================================================
# Konfigurasi pra-produksi. Nilai diberikan melalui environment server / Secret Manager.
# Aturan sama dengan production (backend menolak ENABLE_MOCK_CBS, Redis wajib,
# OTP SANDBOX ditolak, APP_VERSION wajib):
#   APP_ENV=staging, DB_NAME=mbanking_staging, DB_SSL=verify-full, HTTPS wajib
#   Credential & secret KHUSUS staging. Tidak memakai data nasabah sungguhan tanpa
#   otorisasi dan prosedur bank.


# =========================================================
# D. PRODUCTION CONFIGURATION
# =========================================================
# Konfigurasi produksi. Secret WAJIB berasal dari environment server atau Secret Manager:
#   APP_ENV=production, APP_VERSION=<versi rilis>
#   DB_NAME=mbanking_prod, DB_USER=mbanking_app, DB_PASS, DB_SSL=verify-full
#   REDIS_HOST, REDIS_PASS
#   JWT_SECRET, ADMIN_JWT_SECRET, DB_ENCRYPTION_KEY
#   ENABLE_MOCK_CBS=false, CBS_BASE_URL, CBS_CLIENT_ID, CBS_CLIENT_SECRET
#   TRUSTED_PROXIES=<alamat reverse proxy>
# Job migrasi (terpisah dari backend): MIGRATION_DB_USER / MIGRATION_DB_PASS.
# docker-compose.yml (server) juga membaca: DB_OWNER_USER, DB_OWNER_PASS, APP_DB_PASS,
# AUDIT_DB_PASS, POSTGRES_BIND_ADDR, APP_BIND_ADDR.
# Prosedur lengkap: docs/DEPLOYMENT_AND_CICD.md
