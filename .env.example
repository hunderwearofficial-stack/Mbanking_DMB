# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_NAME=MBanking-BPR-Backend
APP_VERSION=v1.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=mbanking_bpr
DB_SSL=disable

# Redis Configuration (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=bpr-rahasia-super-aman-jwt-key-2026!
JWT_EXPIRY_MINUTES=60

# Rate Limiter
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=60

# Security & Column-Level Encryption (AES-256-GCM - OJK & UU PDP Compliance)
# Master key must be exactly 32 bytes (256-bit) or 64-character hex string
DB_ENCRYPTION_KEY=dmb-bank-aes256-gcm-master-key32

# Core Banking System (CBS) OpenAPI Setting
ENABLE_MOCK_CBS=false
CBS_BASE_URL=https://api-dev.bpr-danamandiribogor.co.id
